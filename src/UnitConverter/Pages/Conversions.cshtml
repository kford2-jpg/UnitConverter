@page "{ConversionType?}/{Input?}"
@model UnitConverter.Pages.ConversionsModel

@if (ViewData["ErrorMessage"] != null)
{
    <p class="text-danger">@ViewData["ErrorMessage"]</p>
}
else
{
    <h1>@Model.DisplayConversionType</h1>

    <p>Input: @Model.Conversion.Input</p>

    <p>Output: @Model.Conversion.Output</p>

    <a href="/">Return to the conversion form</a>
}
