@page
@model UnitConverter.Pages.LogsModel

@{
    ViewData["Title"] = "Application Logs";
}

<h1>Application Logs</h1>

<form method="get">
    <div class="mb-3">
        <label asp-for="Search" class="form-label">Search</label>
        <input asp-for="Search" class="form-control"
               placeholder="Search messages, inputs, or results" />
    </div>

    <div class="mb-3">
        <label asp-for="Level" class="form-label">Level</label>
        <select asp-for="Level" class="form-select">
            <option value="">All</option>
            <option value="Information">Information</option>
            <option value="Warning">Warning</option>
            <option value="Error">Error</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="ConversionType" class="form-label">
            Conversion
        </label>
        <select asp-for="ConversionType" class="form-select">
            <option value="">All</option>
            @foreach (var conversion in UnitConverter.Models.ConversionTypes.All)
            {
                <option value="@conversion">@conversion</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Search</button>
    <a asp-page="/Logs" class="btn btn-secondary">Clear</a>
</form>

<hr />

@if (Model.Entries.Count == 0)
{
    <p>No log entries match your filters.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">Timestamp</th>
                    <th scope="col">Level</th>
                    <th scope="col">Message</th>
                    <th scope="col">Conversion</th>
                    <th scope="col">Input</th>
                    <th scope="col">Result</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Entries)
                {
                    <tr>
                        <td>@entry.Timestamp</td>
                        <td>@entry.Level</td>
                        <td>@entry.Message</td>
                        <td>@entry.ConversionType</td>
                        <td>@entry.Input</td>
                        <td>@entry.Result</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
